{
  "name": "morphbyte-workspace",
  "private": true,
  "version": "0.1.2",
  "workspaces": [
    "packages/morphbyte"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test": "node --test packages/tests/*.test.mjs",
    "test:bun": "bun run scripts/bun-smoke.mjs",
    "check": "tsc --noEmit",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "bench": "node packages/benchmarks/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "bun": "^1.3.1",
    "cmake-js": "^8.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
